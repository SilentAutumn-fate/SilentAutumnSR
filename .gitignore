# ---------------------------------------------------------------------------
# Build output and machine-local state. None of this belongs in the repository.
# ---------------------------------------------------------------------------

# compiled server
/dist
/build

# dependencies - install.bat restores them with `npm install`
/node_modules

# private Node.js copy that install.bat downloads (about 100 MB)
/runtime/*
!/runtime/client/
!/runtime/kcp/
__pycache__/
*.py[cod]

# TypeScript incremental build cache
*.tsbuildinfo

# save file: created automatically on first start from the freesr profile
/src/data/data-in-game.json
/src/data/grid-fight-runs.json
/server.config.json
.env
.env.*
!.env.example

# the protocol runtime is generated from src/proto/StarRail.proto
# (about 55 MB) by `node tools/gen-proto.js`
/src/proto/starrail.gen.js
/src/proto/starrail.ts
/src/proto/.inputs.sha256
/src/proto/4.7.51/schema.json
/src/proto/4.7.51/CmdId.json
/src/proto/4.7.51/handler-commands.json

# ---------------------------------------------------------------------------
# Optional local integration tools and private certificates
/FireFly.Proxy.v2/config.json
/launcher/
*.pfx
*.p12
*.key
*.pem
# ---------------------------------------------------------------------------

# ---------------------------------------------------------------------------
# Noise
# ---------------------------------------------------------------------------
logs
*.log
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*
.DS_Store
# editor / OS junk that must not creep in through drag-and-drop on Windows
Thumbs.db
ehthumbs.db
Desktop.ini
*~
*.swp

/coverage
/.nyc_output

/.idea
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace

.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# archived development logs (current run logs stay in /logs)
/dev/logs-archive/

# isolated verification instance: copied data/logs for a second server on other
# ports (SASR_* overrides), never committed
/_e2e/
