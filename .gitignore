# compiled output
/dist
/node_modules
/build
.history

# ============================================================
# 排除规则（FireFly 目录在下方显式放行）
# ============================================================

# 证书与私钥
*.pfx
*.p12
*.key

# 其它二进制
*.exe
*.dll
*.sys
*.so
*.dylib

# ============================================================
# FireFly 代理工具：整体入库
#   rootCert.pfx 经核实为该工具的公开发行默认证书
#   （CN=Titanium Root Certificate Authority，与独立发行包内文件 SHA256 一致）
#   git 规则「后写的覆盖先写的」，故放行规则必须写在排除规则之后
# ============================================================
!FireFly.Proxy.v2/**

# Logs
logs
*.log
npm-debug.log*
pnpm-debug.log*
yarn-debug.log*
yarn-error.log*
lerna-debug.log*

# OS
.DS_Store

# Tests
/coverage
/.nyc_output

# IDEs and editors
/.idea
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace

# IDE - VSCode
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# dotenv environment variable files
.env
.env.development.local
.env.test.local
.env.production.local
.env.local

# temp directory
.temp
.tmp

# Runtime data
pids
*.pid
*.seed
*.pid.lock

# Diagnostic reports (https://nodejs.org/api/report.html)
report.[0-9]*.[0-9]*.[0-9]*.[0-9]*.json
