# Normalise line endings so a Windows checkout and a Linux/macOS checkout agree.
* text=auto

# Batch files must keep CRLF or cmd.exe mis-parses them.
*.bat text eol=crlf
*.cmd text eol=crlf
*.ps1 text eol=crlf

# Shell/JS/TS/Markdown: LF everywhere.
*.sh text eol=lf
*.js text eol=lf
*.ts text eol=lf
*.json text eol=lf
*.md text eol=lf
*.yml text eol=lf
*.yaml text eol=lf

# The extracted design data and the protobuf dump are large, machine-generated
# and never hand-edited: keep them byte-exact and out of diffs.
src/data/resources/*.json -text -diff
src/proto/StarRail.proto -text -diff
src/proto/CmdId.json -text -diff
package-lock.json -diff

# Binary
*.png binary
*.jpg binary
*.zip binary
*.exe binary
*.dll binary
*.pfx binary

# Preserve the original FireFly package JSON byte for byte.
FireFly.Proxy.v2/config.json -text
FireFly.Proxy.v2/config.tmpl.json -text
